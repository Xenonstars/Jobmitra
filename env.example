# ===========================
# APPLICATION CONFIGURATION
# ===========================

ENVIRONMENT=development
# Options: development, staging, production
DEBUG=true
APP_VERSION=1.0.0


# ===========================
# API SERVER
# ===========================

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api


# ===========================
# DATABASE (PostgreSQL)
# ===========================

# Format: postgresql://username:password@host:port/database
# For Docker Compose development:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/job_automation

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# For production, use environment-specific credentials
# DATABASE_URL=postgresql://prod_user:SECURE_PASSWORD@prod-db.rds.amazonaws.com:5432/job_automation


# ===========================
# CACHE (Redis)
# ===========================

# Format: redis://:password@host:port/database
# For Docker Compose development:
REDIS_URL=redis://:redis@redis:6379/0
REDIS_PASSWORD=redis

# Cache TTL (Time To Live) in seconds
REDIS_CACHE_TTL=86400  # 24 hours
REDIS_SESSION_TTL=604800  # 7 days

# For production:
# REDIS_URL=redis://:SECURE_PASSWORD@prod-redis.elasticache.amazonaws.com:6379/0


# ===========================
# LLM (Local Ollama)
# ===========================

# Provider: 'ollama' (local) or 'anthropic' (cloud)
LLM_PROVIDER=ollama

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model selection (any model you've pulled via `ollama pull`)
# Available locally: deepseek-r1:8b, qwen3:8b, llama3.2
LLM_MODEL=deepseek-r1:8b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120

# Anthropic (optional fallback)
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX


# ===========================
# JOB BOARD CREDENTIALS
# ===========================

# LinkedIn (optional - for authenticated scraping)
LINKEDIN_EMAIL=your-email@gmail.com
LINKEDIN_PASSWORD=ENCRYPTED_PASSWORD_HERE

# Naukri (optional - for authenticated apply)
NAUKRI_USERNAME=your-naukri-username
NAUKRI_PASSWORD=ENCRYPTED_PASSWORD_HERE


# ===========================
# CORS CONFIGURATION
# ===========================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:8000


# ===========================
# RATE LIMITING
# ===========================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60


# ===========================
# LOGGING
# ===========================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
# Options: json, text

# Sentry error tracking (optional)
SENTRY_DSN=


# ===========================
# JOB DISCOVERY
# ===========================

# Job search timeout (seconds)
JOB_SEARCH_TIMEOUT=30

# Number of retries on failure
JOB_SEARCH_RETRIES=3

# Cache duration for job listings (seconds)
JOB_CACHE_TTL=86400  # 24 hours

# Avoid searching for same keywords within N days
JOB_DEDUP_DAYS=7


# ===========================
# APPLICATION SUBMISSION
# ===========================

# Retry settings for application submissions
APPLICATION_RETRY_ATTEMPTS=3
APPLICATION_RETRY_DELAY=5

# CAPTCHA handling timeout (seconds)
CAPTCHA_WAIT_TIMEOUT=300

# Browser automation settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30
BROWSER_SLOWMO=0  # milliseconds between actions


# ===========================
# FEATURE FLAGS
# ===========================

ENABLE_LINKEDIN_APPLY=true
ENABLE_NAUKRI_APPLY=true
ENABLE_GENERIC_APPLY=true
ENABLE_JOB_MATCHING=true
ENABLE_RESUME_TAILORING=true


# ===========================
# DATA RETENTION
# ===========================

# Keep application history for N days
KEEP_APPLICATION_HISTORY_DAYS=730  # 2 years

# Keep job cache for N days
KEEP_JOB_CACHE_DAYS=30

# Keep N versions of resume
KEEP_RESUME_VERSIONS=10


# ===========================
# FRONTEND (Streamlit)
# ===========================

API_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_RUNONSAVE=true


# ===========================
# PRODUCTION OVERRIDES
# ===========================
# Uncomment and configure for production deployment

# ENVIRONMENT=production
# DEBUG=false
# DATABASE_URL=postgresql://prod_user:STRONG_PASSWORD@prod-db.rds.amazonaws.com/job_automation
# REDIS_URL=redis://:STRONG_PASSWORD@prod-redis.elasticache.amazonaws.com:6379/0
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX
# API_URL=https://api.yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# LOG_LEVEL=WARNING
# SENTRY_DSN=https://YOUR_SENTRY_KEY@sentry.io/PROJECT_ID
